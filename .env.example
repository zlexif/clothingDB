# Copy this file to .env and fill in what you need. .env is git-ignored; never commit it.

# ---------------------------------------------------------------- site
# Folder holding the garment/ and ped/ picture sets. Leave unset for the clothingDB CDN.
# WAKU_PUBLIC_CDN_BASE=https://cdn.auradevelopment.xyz/clothingdb

# Where the Creator Lab loads the peds from. Use the public clothingDB peds:
# WAKU_PUBLIC_PEDS_BASE=https://cdn.auradevelopment.xyz/clothingdb/peds
# or your own export served with bun run serve-peds:
# WAKU_PUBLIC_PEDS_BASE=http://localhost:3100

# ---------------------------------------------------------------- picture pipeline
# Only for uploading pictures or peds to YOUR OWN Cloudflare R2 bucket.
# Not needed to run the site or to contribute; leave this section empty.

# Cloudflare dashboard > R2 > Overview: "Account ID" on the right.
R2_ACCOUNT_ID=

# R2 > Manage R2 API Tokens > Create API token
#   Permissions: Object Read & Write
#   Specify bucket: only the bucket below
# Copy the "Access Key ID" and "Secret Access Key" it shows (once).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Your bucket, and the folder inside it the pictures go into.
R2_BUCKET=
R2_PREFIX=clothingdb

# Public address of that folder, for example https://cdn.your-server.com/clothingdb
CDN_PUBLIC_BASE=

# Where scripts/render-cdn.ts writes pictures before upload (outside OneDrive).
# CDN_RENDER_DIR=C:\Users\you\clothingdb-cdn
