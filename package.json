{
  "name": "clothingdb",
  "version": "0.1.0",
  "description": "The FiveM ped clothing directory and capture lab, by Aura Development.",
  "license": "MIT",
  "author": "Aura Development",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "waku dev",
    "build": "waku build",
    "start": "waku start",
    "deploy": "bun scripts/deploy.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typos": "typos",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "hooks": "lefthook install",
    "build-manifest": "bun scripts/build-manifest.ts",
    "make-favicon": "bun scripts/make-favicon.ts",
    "export-peds": "dotnet run --project tools/ped-export/src/PedExport -c Release",
    "export-overlays": "dotnet run --project tools/ped-export/src/PedExport -c Release -- --overlays",
    "serve-peds": "bun scripts/serve-peds.ts",
    "render-cdn": "node --env-file=.env scripts/render-cdn.ts",
    "upload-cdn": "bun scripts/upload-cdn.ts",
    "upload-peds": "node --env-file=.env scripts/upload-peds.ts",
    "make-previews": "node scripts/make-previews.ts",
    "test-exporter": "dotnet test tools/ped-export/ped-export.sln -c Release"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "fumadocs-core": "^16.17.8",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "^16.17.8",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-server-dom-webpack": "~19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "waku": "1.0.0-rc.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.186.0",
    "lefthook": "^2.2.2",
    "playwright-core": "^1.64.1",
    "tailwindcss": "4",
    "typescript": "^5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.154.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zlexif/clothingDB.git"
  }
}
